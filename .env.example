# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/driver_monitoring_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=driver_monitoring_db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_this_in_production

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Hardware/Sensor Configuration
SENSOR_SAMPLE_RATE=100
ECG_ENABLED=True
PPG_ENABLED=True
MPU6050_ENABLED=True
TEMP_SENSOR_ENABLED=True

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
